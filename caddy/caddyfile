:8080 {
	encode gzip

	# Agent download must reach Flask. Without these the catch-all below sent
	# /static/client.py to Vite, which has no such file, so the only working
	# URL was Flask's own port 5000 - which the firewall usually blocks.
	reverse_proxy /static/* 127.0.0.1:5000

	reverse_proxy /client.py 127.0.0.1:5000

	reverse_proxy /api/* 127.0.0.1:5000

	reverse_proxy /socket.io/* 127.0.0.1:5000

	# Prefer Vite for development. If it is stopped, Flask can serve the
	# previously built dashboard from dist/ (run npm ci && npm run build).
	reverse_proxy 127.0.0.1:5173

	handle_errors {
		@dashboard {
			expression `{http.error.status_code} == 502`
			not path /api/* /socket.io/* /static/* /client.py
		}
		handle @dashboard {
			reverse_proxy 127.0.0.1:5000
		}
		handle {
			respond "Upstream unavailable. Start Flask and check the service logs." {http.error.status_code}
		}
	}
}
